{
  "name": "@workspace/gateway-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "backup": "node scripts/backup-now.mjs",
    "db:restore": "node scripts/restore-backup.mjs",
    "test": "node --test --test-concurrency=1 --test-force-exit tests/*.test.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "jsdom": "^30.1.3"
  }
}
