# Copy to .env for local development (NEVER commit .env or real values). On Render, set these in the
# service's Environment tab (render.yaml already declares them). Names only — no real secrets belong in this file.

# --- Runtime ---
NODE_ENV=production
APP_ENV=production                  # "production" enables Secure/__Host- cookies; use "development" only for local http://
PORT=10000                          # Render injects PORT itself — do not set it there
APP_URL=https://your-service.onrender.com    # public https URL, no trailing slash. Drives OAuth redirects, Origin/CSRF checks, emails, API links.
                                    # (If unset, Render's RENDER_EXTERNAL_URL is used as a fallback.)

# --- Database (PostgreSQL) ---
DATABASE_URL=                       # PostgreSQL URI. Aiven/Neon: keep ?sslmode=require. Render Postgres: its "Internal Database URL"
DATABASE_CA=                        # Aiven: the whole "CA certificate" text (BEGIN/END lines included; plain, with \n, or base64). Leave empty for Neon/Render.
DATABASE_SSL=                       # optional: 1 = require TLS; unset = auto (TLS for Render's external hostname). Never set 0 in production.
PG_POOL_MAX=10                      # optional connection-pool size

# --- Accounts / admin ---
ADMIN_EMAIL=                        # the one SUPER_ADMIN account's email
ADMIN_PASSWORD=                     # secret — required in production; admin login is disabled while unset

# --- Secrets ---
SESSION_SECRET=                     # secret — 32+ random chars; signs session ids & CSRF tokens
ENCRYPTION_KEY=                     # secret — 32+ random chars; AES-256-GCM key for API keys, webhook secrets, OAuth tokens.
                                    #   Keep it the SAME across deploys, or previously-sealed values become unreadable.
WEBHOOK_SECRET=                     # secret — shared HMAC secret for the signed provider webhook

# --- Google OAuth (Gmail connect: user reconciliation + admin sender) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=               # secret

# --- Gmail payment-notification reconciliation ---
GMAIL_ALLOWED_SENDERS=              # comma list of bank/FamApp alert senders/domains, e.g. no-reply@famapp.in
GMAIL_PROVIDER_MAP=                 # optional: domain:Label,domain:Label — e.g. famapp.in:FamApp
GMAIL_IDLE_POLL=1                   # 1 (default): merchants WITHOUT an open order also get their FamPay balance refreshed from new alerts at the same interval; 0 = off
GMAIL_POLL_SECONDS=2                 # how often (seconds, min 1, default 2) the server reads the Gmail INBOX of merchants with an OPEN order (and refreshes the balance of the rest); 0 = off
# --- Alerts when payment checking stops working (Telegram message + e-mail to the admin) ---
ALERT_TELEGRAM_CHAT_ID=7642584056   # Telegram user id that receives the alerts (default 7642584056; "off" = no Telegram). Needs TELEGRAM_BOT_TOKEN, and you must press Start in the bot once
ALERT_EMAIL=                        # default: ADMIN_EMAIL ("off" = no e-mail). Sent through Admin -> Support email (the connected Gmail sender)
PAYMENT_ALERTS=1                    # 0 = all alerts off
ALERT_STARTUP=1                     # 0 = no "Gateway started" Telegram message after a restart
GMAIL_REQUIRE_DKIM=1
GMAIL_REQUIRE_REFERENCE=1

# --- Sign-up email rules ---
ALLOWED_EMAIL_DOMAINS=              # optional allow-list, e.g. gmail.com
BLOCKED_EMAIL_DOMAINS=              # optional extra disposable domains to refuse
EMAIL_DNS_CHECK=1

# --- Misc ---
PBKDF2_ITERATIONS=100000
UPI_NAME=                           # optional default payee name shown on QR codes
CLIENT_IP_HEADER=                   # optional: force the header used for the caller IP (rate limits/audit), e.g. cf-connecting-ip
TRUSTED_PROXY_HOPS=1                # fallback only: which X-Forwarded-For entry from the right is the real client

# --- Encrypted database backup to a private Telegram channel (optional) ---
TELEGRAM_BOT_TOKEN=                 # secret — from @BotFather
TELEGRAM_BACKUP_CHAT_ID=-1004175182142  # private channel id like -1001234567890 (add the bot as channel ADMIN)
BACKUP_PASSPHRASE=                  # secret — 16+ chars; encrypts the backups. Keep a copy OUTSIDE Render. Defaults to ENCRYPTION_KEY
BACKUP_INTERVAL_HOURS=6               # optional: hours between automatic Telegram backups (default 6)
TELEGRAM_BACKUP_PIN=1               # optional: 1 (default) pins each single-file backup so an empty database can find it; 0 = do not pin
TELEGRAM_WEBHOOK_SECRET=            # secret — 32+ chars shared with the existing update handler when forwarding to this app
